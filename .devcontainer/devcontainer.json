{
  "name": "ts-axioms",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers-extra/features/bun:1": { "version": "1.3.6" }
  },
  "postCreateCommand": "bun install && bunx playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome"],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true
      }
    }
  }
}
