{
  "name": "@ts-axioms/root",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web & wait",
    "dev:server": "cd apps/server && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "bun run scripts/check-colocated-tests.ts && bun test apps/server shared scripts",
    "test:e2e": "cd apps/e2e && bunx playwright test",
    "test:mutation": "bunx stryker run",
    "typecheck": "tsc -b",
    "audit": "bunx fallow dead-code && bunx fallow dupes && bunx fallow audit --gate all",
    "verify": "bun run lint:ci && bun run typecheck && bun run test && bun run audit",
    "openapi:gen": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run scripts/generate-openapi.ts --check",
    "scaffold:slice": "bun run scripts/scaffold-slice.ts",
    "scaffold:clean": "bun run scripts/scaffold-clean.ts",
    "prepare": "bunx lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@stryker-mutator/core": "^9.6.1",
    "effect": "^3.21.0",
    "fallow": "^2.88.1",
    "lefthook": "^2.1.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
